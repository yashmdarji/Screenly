# Screenly Application Configuration

# Application
APP_NAME=Screenly
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
DATABASE_URL=sqlite:///./screenly.db

# LLM Provider Configuration
# Supported providers: "mock" (offline/zero-key), "gemini", "openai", "groq"
LLM_PROVIDER=mock

# Gemini API Key (Optional - when LLM_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API Key (Optional - when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# RAG & Embeddings
EMBEDDING_PROVIDER=local_semantic
KNOWLEDGE_BASE_DIR=./data/knowledge_base
UPLOAD_DIR=./uploads
TOP_K_RETRIEVAL=3
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# Interview Session Settings
QUESTIONS_PER_SESSION=5
ENABLE_ADAPTIVE_DIFFICULTY=True
ENABLE_FOLLOWUP_PROBES=True
